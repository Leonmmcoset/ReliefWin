[Version]
Signature = "$Windows NT$"
;Signature = "$ReactOS$"

[SystemTrees]
Windows = "\"
"Program Files" = "\Program Files"

; A directory listed here is created empty.
[SystemTrees.Exclude]
"Windows\system32\config" = 1
"Windows\SysWOW64\config" = 1
"Windows\TEMP" = 1
"Windows\SystemTemp" = 1
"Windows\system32\applaunch.exe" = 1
"Windows\unattend.inf" = 1

; A file listed here keeps its installed copy when Setup upgrades ReliefWin,
; and is copied only when it is missing.
[SystemTrees.Preserve]
"Windows\system.ini" = 1
"Windows\win.ini" = 1
"Windows\system32\drivers\etc\hosts" = 1
"Windows\system32\drivers\etc\networks" = 1
"Windows\system32\drivers\etc\protocol" = 1
"Windows\system32\drivers\etc\services" = 1

[DiskSpaceRequirements]
; Required free system partition disk space in MB
FreeSysPartDiskSpace = 450

[HardwareIdsDatabase]
*PNP0A03 = pci
*PNP0A08 = pci
*PNP0C08 = acpi
PCI\CC_0604 = pci
PCI\VEN_104B&CC_0100 = buslogic
PCI\CC_010601 = storahci
ACPI\CLS_0001&SUBCLS_0006&PI_01 = storahci
PCI\VEN_1000&DEV_0050 = lsi_sas
PCI\VEN_1000&DEV_0054 = lsi_sas
PCI\VEN_1000&DEV_0056 = lsi_sas
PCI\VEN_1000&DEV_0058 = lsi_sas
PCI\VEN_1000&DEV_0030 = lsi_sas
USB\CLASS_09 = usbhub
USB\ROOT_HUB = usbhub
USB\ROOT_HUB20 = usbhub
USB\ROOT_HUB30 = usbhub
PCI\CC_0C0300 = usbuhci
PCI\CC_0C0310 = usbohci
PCI\CC_0C0320 = usbehci
PCI\CC_0C0330 = usbxhci
PCI\VEN_1DE4&DEV_0001 = rp1
RP1\GEM = rp1gem
USB\Class_08&SubClass_06&Prot_50 = usbstor
USB\Class_08&SubClass_05&Prot_50 = usbstor
HID_DEVICE_SYSTEM_KEYBOARD = kbdhid,{4D36E96B-E325-11CE-BFC1-08002BE10318}
USB\COMPOSITE = usbccgp
GenDisk = disk,{4D36E967-E325-11CE-BFC1-08002BE10318}
USB\Class_03 = hidusb
GENERIC_HID_DEVICE = hidusb
ROOT\SWENUM = swenum

[HardwareIdsDatabase.x86]
*PNP0A00 = isapnp
PCI\CC_0601 = isapnp
PCI\CC_0101 = pciide
PCI\CC_0104 = pciide
PCI\CC_0105 = pciide
PCI\CC_0106 = pciide
*PNP0600 = atapi
*PNP0303 = i8042prt,{4D36E96B-E325-11CE-BFC1-08002BE10318}
*PNP030B = i8042prt,{4D36E96B-E325-11CE-BFC1-08002BE10318}
*nEC1F00 = inport,{4D36E96F-E325-11CE-BFC1-08002BE10318}

[HardwareIdsDatabase.amd64]
*PNP0A00 = isapnp
PCI\CC_0601 = isapnp
PCI\CC_0101 = pciide
PCI\CC_0104 = pciide
PCI\CC_0105 = pciide
PCI\CC_0106 = pciide
*PNP0600 = atapi
*PNP0303 = i8042prt,{4D36E96B-E325-11CE-BFC1-08002BE10318}
*PNP030B = i8042prt,{4D36E96B-E325-11CE-BFC1-08002BE10318}
*nEC1F00 = inport,{4D36E96F-E325-11CE-BFC1-08002BE10318}

[BootBusExtenders.Load]
acpi = acpi.sys
pci = pci.sys
rp1 = rp1.sys

[BootBusExtenders.Load.x86]
isapnp = isapnp.sys

[BootBusExtenders.Load.amd64]
isapnp = isapnp.sys

[InputDevicesSupport.Load]
usbehci = usbehci.sys
usbohci = usbohci.sys
usbuhci = usbuhci.sys
usbxhci = usbxhci.sys
usbhub = usbhub.sys
usbccgp = usbccgp.sys
hidusb = hidusb.sys
usbstor = usbstor.sys

[Keyboard.Load]
kbdhid = kbdhid.sys

[Keyboard.Load.x86]
i8042prt = i8042prt.sys

[Keyboard.Load.amd64]
i8042prt = i8042prt.sys

[BusExtenders.Load]

[BusExtenders.Load.x86]
pciide = pciide.sys
atapi = atapi.sys

[BusExtenders.Load.amd64]
pciide = pciide.sys
atapi = atapi.sys

[SCSI.Load]
buslogic = buslogic.sys
storahci = storahci.sys
lsi_sas = lsi_sas.sys
disk = disk.sys

[SCSI.Load.x86]
atapi = atapi.sys

[SCSI.Load.amd64]
atapi = atapi.sys

[MouseDrivers.Load]

[MouseDrivers.Load.x86]
inport = inport.sys

[MouseDrivers.Load.amd64]
inport = inport.sys

[SetupData]
DefaultPath = \Windows
SetupDebugOptions = "/DEBUG /KDSERIAL /DEBUGPORT=COM1 /FIRSTCHANCE"
;SetupDebugOptions = "/DEBUG /DEBUGPORT=SCREEN"
OsLoadOptions = "/FASTDETECT /NOGUIBOOT /NODEBUG"

[NLS]
AnsiCodepage     = c_936.nls
OemCodepage      = c_936.nls
UnicodeCasetable = l_intl.nls
DefaultLayout    = 00000409
DefaultLanguage  = 00000804

[Computer.NTx86]
acpi_mp = "ACPI PC"

[Computer.NTamd64]
x64_mp = "Standard x64 PC"

[Map.Computer.NTx86]
acpi_mp = "ACPI MP"

[Map.Computer.NTamd64]
x64_mp = "X64 MP"

[Files.acpi_mp]

[Files.x64_mp]

