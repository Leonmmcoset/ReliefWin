[HiveInfs.Install]
; Called "HiveInfs.Fresh" on Windows
AddReg = caroots.inf,AddReg
AddReg = registry.inf,AddReg
AddReg = comreg.inf,AddReg

[HiveInfs.Upgrade]
AddReg = caroots.inf,AddReg
AddReg = registry.inf,AddReg
AddReg = comreg.inf,AddReg

; Settings an upgrade takes back from the installed system after applying the
; registry above: a whole key, or one value when a value name is given.
[HiveInfs.Upgrade.Keep]
HKLM,"SYSTEM\CurrentControlSet\Control\ComputerName"
HKLM,"SYSTEM\CurrentControlSet\Control\TimeZoneInformation"
HKLM,"SYSTEM\CurrentControlSet\Control\Nls\CodePage","ACP"
HKLM,"SYSTEM\CurrentControlSet\Control\Nls\CodePage","MACCP"
HKLM,"SYSTEM\CurrentControlSet\Control\Nls\CodePage","OEMCP"
HKLM,"SYSTEM\CurrentControlSet\Control\Nls\Language","Default"
HKLM,"SYSTEM\CurrentControlSet\Control\Nls\Language","InstallLanguage"
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon","AutoAdminLogon"
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon","DefaultDomainName"
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon","DefaultPassword"
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon","DefaultUserName"
HKCU,"Control Panel\International"
HKCU,"Keyboard Layout\Preload"

; Registry state of a component this version no longer ships, removed from a
; copy upgraded in place: a whole key, or one value when a value name is given.
[HiveInfs.Upgrade.Remove]
HKLM,"SYSTEM\CurrentControlSet\Services\DiagData"
HKLM,"SOFTWARE\ReliefWin\DiagnosticData"
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\DataCollection","AllowTelemetry"

; Files and directories of such a component, named relative to the system root.
; A second field of "dir" removes a directory and everything under it.
[Files.Upgrade.Remove]
system32\diagdata.exe
DiagnosticData,dir

[Strings]
cdname      = "ReliefWin Installation Media"
productname = "ReliefWin"

; EOF
