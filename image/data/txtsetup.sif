vbe_1280x1024x8  = "VESA Display (1280x1024x8)",,vga,1280,1024,8
vbe_1280x1024x16 = "VESA Display (1280x1024x16)",,vga,1280,1024,16
vbe_1280x1024x24 = "VESA Display (1280x1024x24)",,vga,1280,1024,24
