file(STRINGS "${LIST}" _entries ENCODING UTF-8)
file(REMOVE_RECURSE "${STAGE}")
file(MAKE_DIRECTORY "${STAGE}")
set(_executables "ntoskrnl|csrss|lsass|services|smss|wininit|winlogon|conhost|fontdrvhost|dwm|recoverycenter|cmd|notepad|rundll32|rpcss|svchost|drvinst|spoolsv|ctfmon|conime|userinit")
foreach(_entry IN LISTS _entries)
    if(NOT _entry MATCHES "^/?([^=]+)=(.*)$")
        continue()
    endif()
    set(_path "${CMAKE_MATCH_1}")
    set(_source "${CMAKE_MATCH_2}")
    string(TOLOWER "${_path}" _lower)
    if(NOT _lower MATCHES "^(windows/|users/|programdata/)")
        continue()
    endif()
    if(_lower MATCHES "[.]exe$" AND NOT _lower MATCHES "/(${_executables})[.]exe$")
        continue()
    endif()
    if(_lower MATCHES "^windows/system32/config/(system|software|default|sam|security)$")
        set(_source "${HIVES}/${CMAKE_MATCH_1}")
    endif()
    set(_destination "${STAGE}/${_path}")
    if(IS_DIRECTORY "${_source}")
        file(MAKE_DIRECTORY "${_destination}")
    elseif(EXISTS "${_source}")
        get_filename_component(_parent "${_destination}" DIRECTORY)
        file(MAKE_DIRECTORY "${_parent}")
        file(CREATE_LINK "${_source}" "${_destination}" COPY_ON_ERROR)
    else()
        message(FATAL_ERROR "Missing recovery file: ${_source}")
    endif()
endforeach()
foreach(_file system32/recoverycenter.exe system32/config/system system32/ntoskrnl.exe)
    if(NOT EXISTS "${STAGE}/Windows/${_file}")
        message(FATAL_ERROR "Missing required recovery file: ${_file}")
    endif()
endforeach()
execute_process(COMMAND "${WIMAGE}" capture "${STAGE}" "${WIM}" "ReliefWin Recovery" --compress=xpress --boot --threads=2
    RESULT_VARIABLE _result OUTPUT_VARIABLE _log ERROR_VARIABLE _log)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Recovery image capture failed: ${_log}")
endif()
file(REMOVE_RECURSE "${STAGE}")
