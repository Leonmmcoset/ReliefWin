#include "inetcpl.h"

/* ReactOS localization and supplemental icons kept outside Wine-owned files. */
#define ICO_CERTIFICATES 1314
#define ICO_HISTORY      1315
#define ICO_HOME         1316
#define ICO_TRUSTED      4480
#define ICO_RESTRICTED   4481

#include "inetcpl.rc"

#pragma code_page(65001)

#ifdef LANGUAGE_JA_JP
#include "lang/ja-JP.rc"
#endif
#ifdef LANGUAGE_ZH_CN
#include "lang/zh-CN.rc"
#endif

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

#define WINE_FILENAME_STR "inetcpl.cpl"
#define WINE_FILEDESCRIPTION_STR "Internet Control Panel"
#define WINE_FILEVERSION 8,0,6001,18939
#define WINE_FILEVERSION_STR "8.00.6001.18939"
#define WINE_PRODUCTVERSION 8,0,6001,18939
#define WINE_PRODUCTVERSION_STR "8.00.6001.18939"

#include "wine/wine_common_ver.rc"

ICO_CERTIFICATES ICON "resources/certificates.ico"
ICO_RESTRICTED ICON "resources/restricted.ico"
ICO_HISTORY ICON "resources/history.ico"
ICO_TRUSTED ICON "resources/trusted.ico"
ICO_HOME ICON "resources/home.ico"
