set(_fltk ${CMAKE_CURRENT_SOURCE_DIR}/thirdparty/fltk)
set(_png ${CMAKE_CURRENT_SOURCE_DIR}/thirdparty/libpng)
set(_generated ${CMAKE_CURRENT_BINARY_DIR}/generated)
file(MAKE_DIRECTORY ${_generated}/FL)
set(FL_ABI_VERSION 10404)
set(U16 "unsigned short")
set(U32 "unsigned int")
set(HAVE_SNPRINTF 1)
set(HAVE_VSNPRINTF 1)
set(HAVE_LOCALE_H 1)
set(HAVE_LOCALECONV 1)
set(HAVE_LONG_LONG 1)
set(HAVE_TRUNC 1)
set(HAVE_LIBPNG 1)
set(HAVE_LIBZ 1)
set(HAVE_PNG_H 1)
set(HAVE_PNG_GET_VALID 1)
set(HAVE_PNG_SET_TRNS_TO_ALPHA 1)
set(USE_GDIPLUS 0)
configure_file(${_fltk}/configh.cmake.in ${_generated}/config.h)
configure_file(${_fltk}/fl_config.cmake.in ${_generated}/FL/fl_config.h)
configure_file(${_png}/scripts/pnglibconf.h.prebuilt ${_generated}/pnglibconf.h COPYONLY)
set(_png_sources png.c pngerror.c pngget.c pngmem.c pngpread.c pngread.c
    pngrio.c pngrtran.c pngrutil.c pngset.c pngtrans.c pngwio.c pngwrite.c pngwtran.c pngwutil.c)
list(TRANSFORM _png_sources PREPEND "${_png}/")
add_library(reliefoffice_png STATIC ${_png_sources})
add_dependencies(reliefoffice_png psdk)
target_compile_definitions(reliefoffice_png PRIVATE PNG_ARM_NEON_OPT=0 PNG_INTEL_SSE_OPT=0 PNG_POWERPC_VSX_OPT=0)
target_include_directories(reliefoffice_png PUBLIC ${_png} ${_generated} ${REACTOS_SOURCE_DIR}/sdk/include/reliefwin/libs/zlib)
target_link_libraries(reliefoffice_png PUBLIC zlib libucrtbase)
include(fltk-sources.cmake)
add_library(reliefoffice_fltk STATIC ${RELIEFOFFICE_FLTK_SOURCES})
target_include_directories(reliefoffice_fltk PUBLIC ${_fltk} ${_generated})
target_compile_definitions(reliefoffice_fltk PRIVATE FL_LIBRARY WIN32_LEAN_AND_MEAN NOMINMAX strcasecmp=_stricmp strncasecmp=_strnicmp)
target_link_libraries(reliefoffice_fltk PUBLIC reliefoffice_png reliefoffice_cppstl
    libuser32 libgdi32 libcomctl32 libcomdlg32 libshell32 libole32 uuid libws2_32 libwinspool libadvapi32 libkernel32 libucrtbase libntdll)
if(CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
    target_compile_options(reliefoffice_fltk PRIVATE -Wno-error -Wno-register -Wno-deprecated-declarations)
endif()
