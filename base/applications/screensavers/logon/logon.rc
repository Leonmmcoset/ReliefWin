#include <windef.h>
#include <winuser.h>
#include <scrnsave.h>

#include "resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDI_ICON ICON "res/icon_logon.ico"

#define REACTOS_VERSION_DLL
#define REACTOS_STR_FILE_DESCRIPTION  "ReliefWin Logon ScreenSaver"
#define REACTOS_STR_INTERNAL_NAME     "logon"
#define REACTOS_STR_ORIGINAL_FILENAME "logon.scr"

#include <reliefwin/version.rc>

/* To change the bitmap used for Workstation or Server
 * versions, add the new bitmap and update the path below.
 */
IDB_WORKSTATION BITMAP "res/0.bmp"
IDB_SERVER BITMAP "res/0.bmp"

#include <reliefwin/manifest_exe.rc>

/* UTF-8 */
#pragma code_page(65001)

#ifdef LANGUAGE_EN_US
    #include "lang/en-US.rc"
#endif
#ifdef LANGUAGE_JA_JP
    #include "lang/ja-JP.rc"
#endif
#ifdef LANGUAGE_ZH_CN
    #include "lang/zh-CN.rc"
#endif
