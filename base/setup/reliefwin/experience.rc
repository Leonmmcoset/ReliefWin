#include <windef.h>
#include <winuser.h>
#include "resource.h"

#pragma code_page(65001)

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
STRINGTABLE
BEGIN
    IDS_EXPERIENCE_WELCOME "让我们开始吧"
    IDS_EXPERIENCE_WELCOME_DESC "只需几个步骤，即可完成 ReliefWin 的首次设置。"
    IDS_EXPERIENCE_LANGUAGE "选择你的语言"
    IDS_EXPERIENCE_LANGUAGE_DESC "系统界面与启动菜单将使用此语言。"
    IDS_EXPERIENCE_REGION "键盘与时区"
    IDS_EXPERIENCE_REGION_DESC "选择你习惯的输入布局和当地时区。"
    IDS_EXPERIENCE_KEYBOARD "键盘布局"
    IDS_EXPERIENCE_TIMEZONE "时区"
    IDS_EXPERIENCE_DAYLIGHT "自动调整夏令时"
    IDS_EXPERIENCE_DEVICE "为设备取个名字"
    IDS_EXPERIENCE_DEVICE_DESC "这个名称可帮助你在网络上识别这台计算机。"
    IDS_EXPERIENCE_DEVICE_NAME "计算机名称"
    IDS_EXPERIENCE_DEVICE_HINT "最多 15 个英文字母、数字或连字符，不能全为数字。"
    IDS_EXPERIENCE_NETWORK "连接网络"
    IDS_EXPERIENCE_NETWORK_DESC "现在配置网络，或保持离线并稍后在设置中连接。"
    IDS_EXPERIENCE_NETWORK_SETTINGS "配置网络"
    IDS_EXPERIENCE_WIFI "选择 Wi-Fi 网络"
    IDS_EXPERIENCE_NETWORK_NONE "未发现可用网络连接。你仍可离线完成设置。"
    IDS_EXPERIENCE_NETWORK_LOCAL "本地网络已连接"
    IDS_EXPERIENCE_NETWORK_OFF "尚未连接"
    IDS_EXPERIENCE_ACCOUNT "谁将使用这台设备？"
    IDS_EXPERIENCE_ACCOUNT_DESC "创建本地管理员账户。密码仅用于登录，不会保存为自动登录密码。"
    IDS_EXPERIENCE_USER "用户名"
    IDS_EXPERIENCE_PASSWORD "密码"
    IDS_EXPERIENCE_CONFIRM "确认密码"
    IDS_EXPERIENCE_PASSWORD_HINT "请设置一个密码，并在下方再次输入。"
    IDS_EXPERIENCE_SECURITY "保护你的文件"
    IDS_EXPERIENCE_SECURITY_DESC "查看系统盘加密状态，并确认你能找到恢复密钥。"
    IDS_EXPERIENCE_ENCRYPTED "系统盘已加密"
    IDS_EXPERIENCE_PLAIN "系统盘尚未加密"
    IDS_EXPERIENCE_CRYPT_UNKNOWN "无法读取系统盘加密状态"
    IDS_EXPERIENCE_CRYPT_NOTE "如已加密，请将恢复密钥和恢复包保存在另一台设备或 U 盘中。向导无法从密码推导出原有恢复密钥。未加密时，可稍后从设置启用加密。"
    IDS_EXPERIENCE_CRYPT_OPEN "打开磁盘加密与备份"
    IDS_EXPERIENCE_CRYPT_ACK "我已保管好恢复密钥，或了解可稍后设置"
    IDS_EXPERIENCE_APPS "可选组件"
    IDS_EXPERIENCE_APPS_DESC "这些组件需要联网下载；默认不选。ReliefOffice 已随系统离线安装。"
    IDS_EXPERIENCE_REVIEW "准备好了吗？"
    IDS_EXPERIENCE_REVIEW_DESC "检查以下选择。点击应用后，我们会保存设置并创建你的账户。"
    IDS_EXPERIENCE_APPLYING "正在准备你的设备"
    IDS_EXPERIENCE_APPLYING_DESC "正在保存设置。请保持设备开启。"
    IDS_EXPERIENCE_DONE "一切就绪"
    IDS_EXPERIENCE_DONE_DESC "设置已保存。使用刚创建的账户登录，即可进入桌面。"
    IDS_EXPERIENCE_NEXT "下一步"
    IDS_EXPERIENCE_BACK "上一步"
    IDS_EXPERIENCE_APPLY "应用设置"
    IDS_EXPERIENCE_LOGIN "完成并登录"
    IDS_EXPERIENCE_CLOSE "关闭"
    IDS_EXPERIENCE_PREVIEW "体验模式 · 不保存系统设置"
    IDS_EXPERIENCE_PREVIEW_DONE "体验已完成。此过程没有修改系统配置或创建账户。"
    IDS_EXPERIENCE_ERROR_DEVICE "请输入有效的计算机名称。"
    IDS_EXPERIENCE_ERROR_USER "请输入有效的用户名（最多 20 个字符）。"
    IDS_EXPERIENCE_ERROR_EXISTS "此名称已被使用，请选择其他用户名。"
    IDS_EXPERIENCE_ERROR_PASSWORD "请填写密码，并确保两次输入一致。"
    IDS_EXPERIENCE_ERROR_CRYPTO "请先确认恢复密钥的保存或稍后设置选项。"
    IDS_EXPERIENCE_ERROR_APPLY "未能完成设置。已完成的步骤会保留，你可以重试。"
    IDS_EXPERIENCE_RETRY "重试"
    IDS_EXPERIENCE_QUIT "退出首次设置？"
    IDS_EXPERIENCE_QUIT_DESC "当前选择不会保存。下次登录时会重新打开首次设置。"
    IDS_EXPERIENCE_SUMMARY "语言：%s\n键盘：%s\n时区：%s\n计算机：%s\n本地管理员：%s"
    IDS_EXPERIENCE_STEPS "首次设置"
    IDS_EXPERIENCE_OFFLINE "离线继续"
    IDS_EXPERIENCE_BUSY "正在保存，请稍候…"
    IDS_EXPERIENCE_APP_NAME "组件"
    IDS_EXPERIENCE_APP_SOURCE "下载来源"
    IDS_EXPERIENCE_PREVIEW_NETWORK "体验模式不更改网络或加密配置。"
    IDS_EXPERIENCE_DONE_COMPONENTS "所选组件已安装。你可以继续使用系统。"
    IDS_EXPERIENCE_DONE_RESTART "设置已保存。重新启动以应用设备名称，然后使用新账户登录。"
    IDS_EXPERIENCE_RESTART "完成并重新启动"
END

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
    IDS_EXPERIENCE_WELCOME "Let’s get started"
    IDS_EXPERIENCE_WELCOME_DESC "A few steps will make ReliefWin yours."
    IDS_EXPERIENCE_LANGUAGE "Choose your language"
    IDS_EXPERIENCE_LANGUAGE_DESC "This language will be used by the system and boot menu."
    IDS_EXPERIENCE_REGION "Keyboard and time zone"
    IDS_EXPERIENCE_REGION_DESC "Choose your keyboard layout and local time zone."
    IDS_EXPERIENCE_KEYBOARD "Keyboard layout"
    IDS_EXPERIENCE_TIMEZONE "Time zone"
    IDS_EXPERIENCE_DAYLIGHT "Adjust for daylight saving time automatically"
    IDS_EXPERIENCE_DEVICE "Name your device"
    IDS_EXPERIENCE_DEVICE_DESC "This name helps you recognize this computer on your network."
    IDS_EXPERIENCE_DEVICE_NAME "Computer name"
    IDS_EXPERIENCE_DEVICE_HINT "Use up to 15 letters, numbers or hyphens. Include a letter or hyphen."
    IDS_EXPERIENCE_NETWORK "Connect to a network"
    IDS_EXPERIENCE_NETWORK_DESC "Connect now, or continue offline and connect later in Settings."
    IDS_EXPERIENCE_NETWORK_SETTINGS "Network settings"
    IDS_EXPERIENCE_WIFI "Choose a Wi-Fi network"
    IDS_EXPERIENCE_NETWORK_NONE "No active network connection. You can finish setup offline."
    IDS_EXPERIENCE_NETWORK_LOCAL "Connected to a local network"
    IDS_EXPERIENCE_NETWORK_OFF "Not connected"
    IDS_EXPERIENCE_ACCOUNT "Who will use this device?"
    IDS_EXPERIENCE_ACCOUNT_DESC "Create a local administrator account. Your password will not be stored for automatic sign-in."
    IDS_EXPERIENCE_USER "Username"
    IDS_EXPERIENCE_PASSWORD "Password"
    IDS_EXPERIENCE_CONFIRM "Confirm password"
    IDS_EXPERIENCE_PASSWORD_HINT "Choose a password, then enter it again below."
    IDS_EXPERIENCE_SECURITY "Protect your files"
    IDS_EXPERIENCE_SECURITY_DESC "Check system drive encryption and make sure you can find your recovery key."
    IDS_EXPERIENCE_ENCRYPTED "System drive is encrypted"
    IDS_EXPERIENCE_PLAIN "System drive is not encrypted"
    IDS_EXPERIENCE_CRYPT_UNKNOWN "Encryption status is unavailable"
    IDS_EXPERIENCE_CRYPT_NOTE "If encrypted, keep your recovery key and recovery package on another device or USB drive. Setup cannot recover an existing key from your password. You can enable encryption later in Settings."
    IDS_EXPERIENCE_CRYPT_OPEN "Open encryption and backup"
    IDS_EXPERIENCE_CRYPT_ACK "I have saved my recovery key or will configure encryption later"
    IDS_EXPERIENCE_APPS "Optional components"
    IDS_EXPERIENCE_APPS_DESC "These components need a download and are optional. ReliefOffice is already included with the system."
    IDS_EXPERIENCE_REVIEW "Ready to finish?"
    IDS_EXPERIENCE_REVIEW_DESC "Review your choices. Apply will save settings and create your account."
    IDS_EXPERIENCE_APPLYING "Preparing your device"
    IDS_EXPERIENCE_APPLYING_DESC "Saving your settings. Keep your device turned on."
    IDS_EXPERIENCE_DONE "You’re all set"
    IDS_EXPERIENCE_DONE_DESC "Your settings are saved. Sign in with your new account to reach the desktop."
    IDS_EXPERIENCE_NEXT "Next"
    IDS_EXPERIENCE_BACK "Back"
    IDS_EXPERIENCE_APPLY "Apply settings"
    IDS_EXPERIENCE_LOGIN "Finish and sign in"
    IDS_EXPERIENCE_CLOSE "Close"
    IDS_EXPERIENCE_PREVIEW "Preview · System settings are not saved"
    IDS_EXPERIENCE_PREVIEW_DONE "Preview complete. No system settings or accounts were changed."
    IDS_EXPERIENCE_ERROR_DEVICE "Enter a valid computer name."
    IDS_EXPERIENCE_ERROR_USER "Enter a valid username of up to 20 characters."
    IDS_EXPERIENCE_ERROR_EXISTS "This name is already in use. Choose another username."
    IDS_EXPERIENCE_ERROR_PASSWORD "Enter a password and make sure both entries match."
    IDS_EXPERIENCE_ERROR_CRYPTO "Confirm that your recovery key is saved or that you will configure encryption later."
    IDS_EXPERIENCE_ERROR_APPLY "Setup could not finish. Completed steps are retained; you can retry."
    IDS_EXPERIENCE_RETRY "Retry"
    IDS_EXPERIENCE_QUIT "Leave setup?"
    IDS_EXPERIENCE_QUIT_DESC "Your current choices will not be saved. Setup will open again the next time you sign in."
    IDS_EXPERIENCE_SUMMARY "Language: %s\nKeyboard: %s\nTime zone: %s\nComputer: %s\nLocal administrator: %s"
    IDS_EXPERIENCE_STEPS "First-run setup"
    IDS_EXPERIENCE_OFFLINE "Continue offline"
    IDS_EXPERIENCE_BUSY "Saving, please wait…"
    IDS_EXPERIENCE_APP_NAME "Component"
    IDS_EXPERIENCE_APP_SOURCE "Download source"
    IDS_EXPERIENCE_PREVIEW_NETWORK "Preview does not change network or encryption settings."
    IDS_EXPERIENCE_DONE_COMPONENTS "Your selected components are installed. You can continue using the system."
    IDS_EXPERIENCE_DONE_RESTART "Your settings are saved. Restart to apply the device name, then sign in with your new account."
    IDS_EXPERIENCE_RESTART "Finish and restart"
END

LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT
STRINGTABLE
BEGIN
    IDS_EXPERIENCE_WELCOME "さあ、始めましょう"
    IDS_EXPERIENCE_WELCOME_DESC "いくつかの手順で ReliefWin の初期設定が完了します。"
    IDS_EXPERIENCE_LANGUAGE "言語を選んでください"
    IDS_EXPERIENCE_LANGUAGE_DESC "システムと起動メニューに使用する言語です。"
    IDS_EXPERIENCE_REGION "キーボードとタイムゾーン"
    IDS_EXPERIENCE_REGION_DESC "キーボード配列と地域のタイムゾーンを選択します。"
    IDS_EXPERIENCE_KEYBOARD "キーボード配列"
    IDS_EXPERIENCE_TIMEZONE "タイムゾーン"
    IDS_EXPERIENCE_DAYLIGHT "夏時間を自動的に調整する"
    IDS_EXPERIENCE_DEVICE "デバイスに名前を付ける"
    IDS_EXPERIENCE_DEVICE_DESC "ネットワーク上でこのコンピューターを識別する名前です。"
    IDS_EXPERIENCE_DEVICE_NAME "コンピューター名"
    IDS_EXPERIENCE_DEVICE_HINT "15 文字以内の英数字とハイフンを使用できます。数字だけにはできません。"
    IDS_EXPERIENCE_NETWORK "ネットワークに接続する"
    IDS_EXPERIENCE_NETWORK_DESC "今すぐ接続するか、オフラインで続行して後で設定できます。"
    IDS_EXPERIENCE_NETWORK_SETTINGS "ネットワーク設定"
    IDS_EXPERIENCE_WIFI "Wi-Fi ネットワークを選ぶ"
    IDS_EXPERIENCE_NETWORK_NONE "有効な接続がありません。オフラインで設定を完了できます。"
    IDS_EXPERIENCE_NETWORK_LOCAL "ローカルネットワークに接続済み"
    IDS_EXPERIENCE_NETWORK_OFF "未接続"
    IDS_EXPERIENCE_ACCOUNT "このデバイスを使うのは誰ですか？"
    IDS_EXPERIENCE_ACCOUNT_DESC "ローカル管理者アカウントを作成します。パスワードは自動サインイン用に保存されません。"
    IDS_EXPERIENCE_USER "ユーザー名"
    IDS_EXPERIENCE_PASSWORD "パスワード"
    IDS_EXPERIENCE_CONFIRM "パスワードの確認"
    IDS_EXPERIENCE_PASSWORD_HINT "パスワードを設定し、確認のためもう一度入力してください。"
    IDS_EXPERIENCE_SECURITY "ファイルを保護する"
    IDS_EXPERIENCE_SECURITY_DESC "システムドライブの暗号化状態を確認し、回復キーを保管してください。"
    IDS_EXPERIENCE_ENCRYPTED "システムドライブは暗号化されています"
    IDS_EXPERIENCE_PLAIN "システムドライブは暗号化されていません"
    IDS_EXPERIENCE_CRYPT_UNKNOWN "暗号化状態を取得できません"
    IDS_EXPERIENCE_CRYPT_NOTE "暗号化済みの場合は、回復キーと回復パッケージを別のデバイスや USB に保管してください。既存の回復キーはパスワードから復元できません。暗号化は後で設定から有効にできます。"
    IDS_EXPERIENCE_CRYPT_OPEN "暗号化とバックアップを開く"
    IDS_EXPERIENCE_CRYPT_ACK "回復キーを保管したか、後で暗号化を設定します"
    IDS_EXPERIENCE_APPS "追加コンポーネント"
    IDS_EXPERIENCE_APPS_DESC "これらは任意のダウンロードです。ReliefOffice はシステムに含まれています。"
    IDS_EXPERIENCE_REVIEW "設定を完了しますか？"
    IDS_EXPERIENCE_REVIEW_DESC "選択内容を確認してください。適用すると設定を保存してアカウントを作成します。"
    IDS_EXPERIENCE_APPLYING "デバイスを準備しています"
    IDS_EXPERIENCE_APPLYING_DESC "設定を保存しています。デバイスの電源を切らないでください。"
    IDS_EXPERIENCE_DONE "準備ができました"
    IDS_EXPERIENCE_DONE_DESC "設定を保存しました。作成したアカウントでサインインしてください。"
    IDS_EXPERIENCE_NEXT "次へ"
    IDS_EXPERIENCE_BACK "戻る"
    IDS_EXPERIENCE_APPLY "設定を適用"
    IDS_EXPERIENCE_LOGIN "完了してサインイン"
    IDS_EXPERIENCE_CLOSE "閉じる"
    IDS_EXPERIENCE_PREVIEW "プレビュー · システム設定は保存されません"
    IDS_EXPERIENCE_PREVIEW_DONE "プレビューが完了しました。システム設定やアカウントは変更していません。"
    IDS_EXPERIENCE_ERROR_DEVICE "有効なコンピューター名を入力してください。"
    IDS_EXPERIENCE_ERROR_USER "20 文字以内の有効なユーザー名を入力してください。"
    IDS_EXPERIENCE_ERROR_EXISTS "この名前は使用されています。別のユーザー名を選んでください。"
    IDS_EXPERIENCE_ERROR_PASSWORD "パスワードを入力し、両方が一致することを確認してください。"
    IDS_EXPERIENCE_ERROR_CRYPTO "回復キーの保管または後で設定することを確認してください。"
    IDS_EXPERIENCE_ERROR_APPLY "設定を完了できませんでした。完了した手順は保存されており、再試行できます。"
    IDS_EXPERIENCE_RETRY "再試行"
    IDS_EXPERIENCE_QUIT "設定を終了しますか？"
    IDS_EXPERIENCE_QUIT_DESC "現在の選択は保存されません。次回サインイン時に設定が再開します。"
    IDS_EXPERIENCE_SUMMARY "言語：%s\nキーボード：%s\nタイムゾーン：%s\nコンピューター：%s\nローカル管理者：%s"
    IDS_EXPERIENCE_STEPS "初期設定"
    IDS_EXPERIENCE_OFFLINE "オフラインで続行"
    IDS_EXPERIENCE_BUSY "保存しています。お待ちください…"
    IDS_EXPERIENCE_APP_NAME "コンポーネント"
    IDS_EXPERIENCE_APP_SOURCE "ダウンロード元"
    IDS_EXPERIENCE_PREVIEW_NETWORK "プレビューではネットワークや暗号化の設定を変更しません。"
    IDS_EXPERIENCE_DONE_COMPONENTS "選択したコンポーネントをインストールしました。"
    IDS_EXPERIENCE_DONE_RESTART "設定を保存しました。デバイス名を適用するため再起動し、新しいアカウントでサインインしてください。"
    IDS_EXPERIENCE_RESTART "完了して再起動"
END
