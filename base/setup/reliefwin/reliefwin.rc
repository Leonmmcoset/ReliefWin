#include <windef.h>
#include <winuser.h>
#include <commctrl.h>

#include "resource.h"

#ifndef REACTOS_STR_FILE_DESCRIPTION
#define REACTOS_STR_FILE_DESCRIPTION    "ReliefWin Setup"
#define REACTOS_STR_INTERNAL_NAME       "reliefwin"
#define REACTOS_STR_ORIGINAL_FILENAME   "reliefwin.exe"
#endif
#include <reliefwin/version.rc>

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

/* Icons */
IDI_MAIN        ICON "res/reliefwin.ico"

/* Bitmaps */
IDB_WATERMARK   BITMAP "res/watermark.bmp"
IDB_LOGO        BITMAP "../../system/userinit/res/rosbitmap.bmp"
IDB_LOGOMASK    BITMAP "../../system/userinit/res/rosbitmap_mask.bmp"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "reliefwin.exe.manifest"

/* The file security of the preinstalled image */
IDR_FILESECURITY RCDATA "../../../image/data/filesecurity.txt"

/* UTF-8 */
#pragma code_page(65001)

#ifdef LANGUAGE_EN_US
    #include "lang/en-US.rc"
#endif
#ifdef LANGUAGE_JA_JP
    #include "lang/ja-JP.rc"
#endif
#ifdef LANGUAGE_ZH_CN
    #include "lang/zh-CN.rc"
#endif
