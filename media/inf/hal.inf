; HAL.INF

; Installation file for HAL device

[Version]
Signature  = "$Windows NT$"
;Signature  = "$ReactOS$"
LayoutFile = layout.inf
Class      = Computer
ClassGUID  = {4D36E966-E325-11CE-BFC1-08002BE10318}
Provider   = %ReactOS%
DriverVer  = 08/15/2011,1.00.0.0

[DestinationDirs]
DefaultDestDir = 12

[ClassInstall32.NT]
AddReg = ComputerClass.NT.AddReg

[ComputerClass.NT.AddReg]
HKR, , ,               0, %ComputerClassName%
HKR, , Icon,           0, "-13"

[Manufacturer]
%GenericMfg% = GenericMfg, NTamd64
%MsftMfg% = MsftMfg
%NecMfg% = NecMfg

[GenericMfg]
%acpipic_up.DeviceDesc% = NO_DRV,acpipic_up
%acpiapic.DeviceDesc% = NO_DRV,acpiapic
%acpi_arm64.DeviceDesc% = NO_DRV,ACPIARM64
%e_isa_up.DeviceDesc% = NO_DRV,e_isa_up

[GenericMfg.NTamd64]
%acpipic_up.DeviceDesc% = NO_DRV,acpipic_up
%acpiapic_amd64.DeviceDesc% = ACPI_AMD64_HAL,acpiapic
%e_isa_up.DeviceDesc% = NO_DRV,e_isa_up

[MsftMfg]
%xbox.DeviceDesc% = NO_DRV,xbox

[NecMfg]
%pc98_up.DeviceDesc% = NO_DRV,pc98_up

;------------------------------- NO DRIVER ------------------------------

[NO_DRV]

[NO_DRV.Services]
AddService = , 0x00000002

[ACPI_AMD64_HAL]

[ACPI_AMD64_HAL.Services]
AddService = , 0x00000002

;-------------------------------- STRINGS -------------------------------

[Strings]
; Non-localizable
ReactOS = "ReliefWin Project"

MsftMfg = "Microsoft"
NecMfg = "NEC"

; Localizable
ComputerClassName = "Computer"

GenericMfg = "(Standard computers)"
acpipic_up.DeviceDesc = "ACPI Uniprocessor PC"
acpiapic.DeviceDesc = "ACPI APIC-based PC"
acpiapic_amd64.DeviceDesc = "ACPI x64-based PC"
acpi_arm64.DeviceDesc = "ACPI ARM64-based PC"
e_isa_up.DeviceDesc = "Standard Uniprocessor PC"

xbox.DeviceDesc = "Original Xbox (x86 based)"

pc98_up.DeviceDesc = "Uniprocessor NEC PC-98"

[Strings.0804]
ComputerClassName = "计算机"

GenericMfg = "(通用计算机)"
acpipic_up.DeviceDesc = "ACPI 单处理器 PC"
acpi_arm64.DeviceDesc = "ACPI ARM64-based PC"
e_isa_up.DeviceDesc = "标准单处理器 PC"

xbox.DeviceDesc = "Original Xbox (x86 based)"

pc98_up.DeviceDesc = "Uniprocessor NEC PC-98"
