; ACPI.INF

; Installation file for WMIACPI driver

[Version]
Signature  = "$Windows NT$"
;Signature  = "$ReactOS$"
LayoutFile = layout.inf
Class      = System
ClassGUID  = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider   = %ReactOS%
DriverVer  = 03/26/2015,1.00.0.0

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%GenericMfg% = GenericMfg

[GenericMfg]
%*PNP0C14.DeviceDesc% = WmiAcpi_Inst,*PNP0C14,PNP0C14

[WmiAcpi_Inst.NT]
CopyFiles = WmiAcpi_CopyFiles

[WmiAcpi_CopyFiles]
wmiacpi.sys

[WmiAcpi_Inst.NT.Services]
AddService = WmiAcpi, 0x00000002, WmiAcpi_Service

[WmiAcpi_Service]
DisplayName = %WmiAcpi.ServiceDesc%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\wmiacpi.sys
LoadOrderGroup = Extended Base

;-------------------------------- STRINGS -------------------------------

[Strings]
; Non-localizable
ReactOS = "ReliefWin Project"

; Localizable
GenericMfg = "(Generic system devices)"
*PNP0C14.DeviceDesc = "WMI for ACPI"
WmiAcpi.ServiceDesc = "Windows Management Interface for ACPI"

[Strings.0804]
GenericMfg = "(通用系统设备)"
*PNP0C14.DeviceDesc = "ACPI 的 WMI"
