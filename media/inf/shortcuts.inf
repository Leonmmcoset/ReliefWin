[SystemToolsShortcuts]
%SystemRoot%\system32\camera.exe, %CAMERA_TITLE%, %CAMERA_DESC%, 0
%SystemRoot%\system32\charmap.exe, %CHARMAP_TITLE%, %CHARMAP_DESC%, 0
