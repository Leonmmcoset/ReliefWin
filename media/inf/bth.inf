[Version]
Signature="$Windows NT$"
Class=Bluetooth
ClassGUID={e0cbf06c-cd8b-4647-bb8a-263b43f0f974}
Provider=%ReactOS%
DriverVer=03/27/2012,1.0.0

[DestinationDirs]
DefaultDestDir = 11
BluetoothClass.NT.Files = 11
BthUsb.Files = 12
BthMini.Files = 12

[ClassInstall32.NT]
AddReg=BluetoothClass.NT.AddReg
CopyFiles=BluetoothClass.NT.Files

[BluetoothClass.NT.AddReg]
HKR, , , 0, %BluetoothClassName%
HKR, , NoInstallClass, 0, 1
HKR, , Installer32, , "bthci.dll,BluetoothClassInstaller"
HKR, , Icon, 0, "201"

[BluetoothClass.NT.Files]
bthci.dll

[Manufacturer]
%ReactOS%=ReactOS

[ReactOS]
%BTUSB.DeviceDesc%=BthUsb.Dev, USB\Class_E0&SubClass_01&Prot_01
%BthMini.DeviceDesc%=BthMini.Dev, MS_BTHX_BTHMINI
%BthAuth.DeviceDesc%=BthAuth.Dev, BTH\WINEBTHAUTH
%BthLeDevice.DeviceDesc%=BthLeRaw.Dev, BTHLE\GenericDevice
%BthLeGap.DeviceDesc%=BthLeRaw.Dev, BTHLEDevice\{00001800-0000-1000-8000-00805f9b34fb}
%BthLeGatt.DeviceDesc%=BthLeRaw.Dev, BTHLEDevice\{00001801-0000-1000-8000-00805f9b34fb}
%BthLeDis.DeviceDesc%=BthLeRaw.Dev, BTHLEDevice\{0000180A-0000-1000-8000-00805f9b34fb}
%BthLeScan.DeviceDesc%=BthLeRaw.Dev, BTHLEDevice\{00001813-0000-1000-8000-00805f9b34fb}
%BthLeService.DeviceDesc%=BthLeRaw.Dev, BTHLEDevice\GenericATTService

[BthUsb.Dev.NT]
CopyFiles=BthUsb.Files

[BthUsb.Dev.NT.Services]
AddService = BTHUSB, 0x00000002, BthUsb.AddService

[BthUsb.AddService]
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\bthusb.sys

[BthUsb.Files]
bthusb.sys

[BthMini.Dev.NT]
CopyFiles=BthMini.Files

[BthMini.Dev.NT.Services]
AddService = BthMini, 0x00000002, BthMini.AddService

[BthMini.AddService]
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\bthmini.sys

[BthMini.Files]
bthmini.sys

[BthAuth.Dev.NT]

[BthAuth.Dev.NT.Services]
AddService = , 0x00000002

[BthLeRaw.Dev.NT]

[BthLeRaw.Dev.NT.Services]
AddService = , 0x00000002

;-------------------------------- STRINGS -------------------------------

[Strings]
; Non-localizable
ReactOS = "ReliefWin Project"

; Localizable
BTUSB.DeviceDesc="Generic USB Bluetooth Radio"
BthMini.DeviceDesc="Generic Bluetooth Radio"
BthAuth.DeviceDesc="Bluetooth pairing requests"
BthLeDevice.DeviceDesc="Bluetooth LE Device"
BthLeGap.DeviceDesc="Generic Access Profile"
BthLeGatt.DeviceDesc="Generic Attribute Profile"
BthLeDis.DeviceDesc="Device Information Service"
BthLeScan.DeviceDesc="Scan Parameter Service"
BthLeService.DeviceDesc="Bluetooth LE Generic Attribute Service"
BluetoothClassName="Bluetooth Radios"

[Strings.0804]
BTUSB.DeviceDesc="通用 USB 蓝牙无线电"
